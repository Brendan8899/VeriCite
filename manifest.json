{
	"manifest_version": 3,
	"name": "VeriCite",
	"version": "0.1.0",
	"action": {
		"default_popup": "index.html"
	},
	"permissions": ["activeTab", "declarativeContent", "identity", "storage"],
	"host_permissions": [
		"https://docs.google.com/document/*",
		"https://docs.googleapis.com/*",
		"https://www.googleapis.com/*",
		"https://*/*",
		"http://*/*"
	],
	"oauth2": {
		"client_id": "597339304581-i5tol3c0hmcstu97dm6cfbg9itvob81p.apps.googleusercontent.com",
		"scopes": ["https://www.googleapis.com/auth/documents", "https://www.googleapis.com/auth/books"]
	},
	"background": {
		"service_worker": "dist/service-worker.js",
		"type": "module"
	}
}
