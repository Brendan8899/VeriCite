{
    "manifest_version": 3,
    "name": "VeriCite",
    "version": "0.1.0",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "activeTab",
        "declarativeContent",
        "scripting",
        "identity",
        "storage"
    ],
    "host_permissions": [
        "https://docs.google.com/document/*",
        "https://docs.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": process.env.CLIENT_ID,
        "scopes": [
            "https://www.googleapis.com/auth/documents.readonly"
        ]
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    }
}
